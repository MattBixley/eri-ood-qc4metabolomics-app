#!/usr/bin/env bash

# QC4Metabolomics: a Shiny-based metabolomics QC dashboard, run via Apptainer
# instances (mariadb, qc_process, ms_converter, qc_shiny). See the README for
# the full story on the design choices below; short version:
#
# - This session gets its OWN private stack: its own MariaDB database and
#   its own copy of the demo dataset, staged under this job's own directory
#   rather than the shared project one. That means concurrent sessions never
#   race each other over the same files or database - but it also means
#   each session starts from a fresh, empty QC history rather than showing
#   the team's shared results. That's a deliberate first-build trade-off,
#   not an oversight - see the README before using this for anything beyond
#   a demo/eval.
#
# - Nothing here uses `--fakeroot`. No real eRI account has an
#   /etc/subuid or /etc/subgid range (only template accounts do), so
#   `apptainer instance start --fakeroot` silently dies moments after
#   printing "instance started successfully" - confirmed on both a login
#   node and a compute node, same account. Until that's fixed cluster-wide,
#   every instance here runs as your own regular user instead, which needs
#   the workarounds commented at each step below (real bind-mounted
#   directories instead of --writable-tmpfs's overlay for anything a
#   container writes; mariadb's own entrypoint bootstrap done by hand;
#   qc_shiny's /init entrypoint bypassed entirely).
#
# - db_backup is intentionally NOT started: it exists to back up the team's
#   shared production database, which doesn't apply to a private, ephemeral,
#   per-session sandbox that's gone the moment this session ends.
#
# - qc_process/ms_converter don't use their own /setup/cron_with_env.sh
#   entrypoint (which starts Debian/Ubuntu's `cron`): that fails immediately
#   with "seteuid: Invalid argument" here, cron's own startup behavior under
#   a rootless user namespace, unrelated to which user any specific job
#   would run as. Both containers only ever have ONE job on a fixed
#   1-minute schedule, so run_cron_replacement() below just extracts that
#   one command from the image's baked-in crontab and runs it in a loop
#   instead of using cron at all.
#
# - The job does NOT request --exclusive (an earlier version did, which is
#   also why it always showed the whole node's core count in the OOD
#   dashboard regardless of what num_cores/num_mem were picked on the form -
#   removed). num_cores/num_mem/partition (form.yml) are real SLURM cgroup
#   limits now, and the node is genuinely shared with other jobs. Since
#   Apptainer instances still bind directly onto the node's real (shared)
#   network namespace, mariadb can no longer use the fixed port 3306 from
#   settings_demo.env - a second session on the same node would collide -
#   so before.sh.erb picks a random db_port the same way it already did for
#   Shiny, and $SETTINGS_ENV (a session-local copy of settings_demo.env with
#   MYSQL_PORT overridden) is used everywhere below instead of the original.

set -euo pipefail

# Add the missing module path (kept for parity with the RStudio app - this
# app doesn't currently load any environment modules itself, since the whole
# stack runs inside Apptainer containers, not the host environment).
export MODULEPATH="/agr/persist/apps/eri_rocky8/modules/all:$MODULEPATH"
module purge

APP_SRC="/agr/persist/projects/2026_metabolomics/apps/QC4Metabolomics"
WORKING_DIR="<%= session.staged_root %>"
STATE_DIR="${WORKING_DIR}/state"

for sif in mariadb qc_process qc_converter qc_shiny; do
  [ -f "${APP_SRC}/sif/${sif}.sif" ] || { echo "missing ${APP_SRC}/sif/${sif}.sif" >&2; exit 1; }
done
[ -f "${APP_SRC}/settings_demo.env" ] || { echo "missing ${APP_SRC}/settings_demo.env" >&2; exit 1; }

mkdir -p "${STATE_DIR}"/db "${STATE_DIR}"/data "${STATE_DIR}"/mariadb_run \
         "${STATE_DIR}"/qc_process_run "${STATE_DIR}"/qc_process_varlog \
         "${STATE_DIR}"/ms_converter_run "${STATE_DIR}"/ms_converter_varlog \
         "${STATE_DIR}"/qc_shiny_run "${STATE_DIR}"/qc_shiny_logs "${STATE_DIR}"/qc_shiny_lib

# A session-local copy of settings_demo.env with MYSQL_PORT overridden to
# the random db_port before.sh.erb picked (see submit.yml.erb: the job no
# longer requests --exclusive, so the fixed 3306 in the original file would
# collide the moment two sessions share a node). Used everywhere below
# instead of the original.
SETTINGS_ENV="${STATE_DIR}/settings.env"
sed -E "s/^MYSQL_PORT=.*/MYSQL_PORT=${db_port}/" "${APP_SRC}/settings_demo.env" >"${SETTINGS_ENV}"

# Seed this session's own private data directory from the project's shared
# demo dataset, so there's something to look at - without ever touching (or
# racing another concurrent session over) the shared copy.
if [ -z "$(ls -A "${STATE_DIR}/data" 2>/dev/null)" ]; then
  echo "Seeding session data directory from the project's demo dataset..."
  cp -r "${APP_SRC}/demo/data/." "${STATE_DIR}/data/"
fi

cleanup() {
  apptainer instance stop --all >/dev/null 2>&1 || true
}
trap cleanup EXIT

# qc_process/ms_converter's own entrypoint (/setup/cron_with_env.sh) starts
# Debian/Ubuntu's `cron`, which fails immediately with "seteuid: Invalid
# argument" under this rootless setup - confirmed by hand this happens in
# cron's own startup, even with an empty crontab, so reinstalling the
# baked-in crontab under our own user doesn't help (it's not about a
# specific job's owning user at all). Both containers only ever have ONE
# job on a fixed 1-minute schedule (confirmed: `*/1 * * * * <command>` in
# each image's /var/spool/cron/crontabs/root) - so rather than fighting
# cron's internals inside a vendored image, just extract that one command
# and run it in a plain loop instead of using cron at all.
#
# $2 (pwd) matters more than it looks: `apptainer exec` mirrors the CALLING
# host process's cwd inside the container when that path also happens to
# exist there - and on this cluster it does, since apptainer transparently
# binds the real /agr tree into every container. Since $APP_SRC (this
# script's own cwd) is the project's GPFS checkout - which has its own
# never-built .Rprofile/renv/renv.lock, just like every git clone of this
# project would - landing there by accident makes R's implicit startup
# .Rprofile sourcing try to bootstrap and download a whole renv environment
# from scratch (confirmed by hand) instead of quietly activating the
# already-fully-installed one baked into the image at
# /srv/shiny-server/QC4Metabolomics. Passing an explicit --pwd avoids ever
# leaving this to chance.
run_cron_replacement() {
  local instance="$1" pwd_in_container="$2"
  local cmd
  cmd="$(apptainer exec "instance://${instance}" cat /var/spool/cron/crontabs/root 2>/dev/null \
    | grep -E '^\*/1 \* \* \* \*' | sed -E 's/^\*\/1 \* \* \* \* //')"
  if [ -z "$cmd" ]; then
    echo "no */1 * * * * cron job found in ${instance}'s baked-in crontab - skipping" >&2
    return 0
  fi
  (
    while true; do
      apptainer exec --env-file "$SETTINGS_ENV" --pwd "$pwd_in_container" "instance://${instance}" bash -c "$cmd"
      sleep 60
    done
  ) &
}

cd "$APP_SRC"

#
# mariadb
#
echo "Starting mariadb..."
# Real bind-mounted directories for /var/lib/mysql and /run/mysqld, not
# --writable-tmpfs's synthetic overlay: apptainer's tmpfs overlay upper
# layer throws ENODATA for a lot of writes (including the mysqld.sock unix
# socket bind) when it isn't backed by a real filesystem under a genuine
# (non-fakeroot) user namespace - a real bind for the same path sidesteps it
# entirely, since it bypasses the synthetic overlay.
apptainer instance start --writable-tmpfs --env-file "$SETTINGS_ENV" \
  --bind "${STATE_DIR}/db":/var/lib/mysql \
  --bind "${STATE_DIR}/mariadb_run":/run/mysqld \
  sif/mariadb.sif mariadb

# The stock mariadb Docker entrypoint (which normally bootstraps a fresh
# data directory and provisions MYSQL_DATABASE/USER/PASSWORD from env vars
# on first boot) never runs here, since we exec mariadbd directly - so do
# both steps by hand instead.
echo "Bootstrapping mariadb data directory..."
apptainer exec instance://mariadb \
  mariadb-install-db --datadir=/var/lib/mysql --auth-root-authentication-method=normal \
  >"${STATE_DIR}/mariadb-install-db.log" 2>&1

# No --user=root: we aren't root (see above), and mariadbd doesn't need to
# be told to run as a user we can't become anyway. --port: bind the random
# db_port from before.sh.erb instead of the default 3306 - MYSQL_PORT alone
# (in $SETTINGS_ENV) only tells CLIENT libraries what port to connect to,
# it doesn't tell the server what to listen on.
apptainer exec instance://mariadb mariadbd --port="${db_port}" --skip_ssl --innodb-flush-method=fsync \
  >"${STATE_DIR}/mariadb.log" 2>&1 &

echo "Waiting for mariadb to accept connections..."
waited=0
# --skip-ssl is needed on the client here too, not just the server, or the
# client tools refuse to connect ("SSL is required, but the server does not
# support it").
until apptainer exec instance://mariadb mariadb-admin --skip-ssl ping --silent 2>/dev/null; do
  sleep 2
  waited=$((waited + 2))
  if [ "$waited" -ge 60 ]; then
    echo "mariadb did not come up within 60s - last 20 lines of mariadb.log:" >&2
    tail -n 20 "${STATE_DIR}/mariadb.log" >&2
    exit 1
  fi
done
echo "mariadb up."

echo "Provisioning this session's own database/user..."
db="$(grep -E '^MYSQL_DATABASE=' "$SETTINGS_ENV" | tail -n1 | cut -d= -f2-)"
dbuser="$(grep -E '^MYSQL_USER=' "$SETTINGS_ENV" | tail -n1 | cut -d= -f2-)"
dbpass="$(grep -E '^MYSQL_PASSWORD=' "$SETTINGS_ENV" | tail -n1 | cut -d= -f2-)"
# Deleting the anonymous '' user is required: mariadb-install-db's default
# anonymous user otherwise intercepts localhost auth ahead of the named
# user and every connection gets rejected.
apptainer exec instance://mariadb mariadb --skip-ssl -u root <<SQL >"${STATE_DIR}/mariadb-provision.log" 2>&1
CREATE DATABASE IF NOT EXISTS \`${db}\`;
DELETE FROM mysql.global_priv WHERE User='';
CREATE USER IF NOT EXISTS '${dbuser}'@'localhost' IDENTIFIED BY '${dbpass}';
GRANT ALL PRIVILEGES ON \`${db}\`.* TO '${dbuser}'@'localhost';
CREATE USER IF NOT EXISTS '${dbuser}'@'%' IDENTIFIED BY '${dbpass}';
GRANT ALL PRIVILEGES ON \`${db}\`.* TO '${dbuser}'@'%';
FLUSH PRIVILEGES;
SQL

#
# qc_process (cron file-watcher) and ms_converter (raw -> mzML conversion)
#
echo "Starting qc_process..."
apptainer instance start --writable-tmpfs --env-file "$SETTINGS_ENV" \
  --bind "${STATE_DIR}/data":/data \
  --bind "${STATE_DIR}/qc_process_run":/run \
  --bind "${STATE_DIR}/qc_process_varlog":/var/log \
  sif/qc_process.sif qc_process
# --pwd: see run_cron_replacement's own comment above - this is where the
# image's own already-installed renv/.Rprofile actually live.
run_cron_replacement qc_process /srv/shiny-server/QC4Metabolomics >"${STATE_DIR}/qc_process.log" 2>&1

echo "Starting ms_converter..."
apptainer instance start --writable-tmpfs --env-file "$SETTINGS_ENV" \
  --bind "${STATE_DIR}/data":/data \
  --bind "${STATE_DIR}/ms_converter_run":/run \
  --bind "${STATE_DIR}/ms_converter_varlog":/var/log \
  sif/qc_converter.sif ms_converter
run_cron_replacement ms_converter /converter_scripts >"${STATE_DIR}/ms_converter.log" 2>&1

#
# qc_shiny - the actual dashboard OOD connects users to
#
echo "Starting qc_shiny..."

# shiny-server refuses to start unless `run_as` names a user it can actually
# become - without fakeroot the only user we can ever be is ourselves, so
# rewrite the image's stock 'shiny' to our own username. Also listen on the
# port OOD found for us (before.sh.erb's `port=$(find_port)`), not the
# image's hard-coded 3838.
#
# NOTE: `${port}` here is a plain bash variable, not an ERB tag - this whole
# file is ERB-rendered exactly ONCE, at form-submission time (see
# BatchConnect::Session#stage), using a binding that only has `session`/
# `context` (form fields). `port` doesn't exist until the job actually runs
# later (before.sh.erb's `port=$(find_port)`, at runtime on the compute
# node) - an ERB-interpolated port reference here would fail at submission
# time with "undefined local variable or method", before any job is even
# submitted. `session.staged_root` just above is fine to use as a real ERB
# tag, since `session` genuinely is in scope in that submission-time binding.
cat > "${STATE_DIR}/shiny-server.conf" <<CONF
run_as $(whoami);

app_init_timeout 300;
app_idle_timeout 300;

server {
  listen ${port};

  location / {
    app_dir '/srv/shiny-server/QC4Metabolomics/Shiny_App';
    log_dir /var/log/shiny-server;
  }
}
CONF

# shiny-server resets the environment for each app's R session, so the app's
# MYSQL_*/QC4METABOLOMICS_* config has to come in via Renviron.site instead
# (normally written by the image's own s6 cont-init script, which /init
# would run - we bypass /init entirely below, so do this ourselves).
# $SETTINGS_ENV is already plain KEY=value, same syntax Renviron.site uses,
# so this is just a straight concatenation (and carries the real db_port,
# unlike the original settings_demo.env's fixed 3306).
{
  echo "R_LIBS=\${R_LIBS-'/usr/local/lib/R/site-library:/usr/local/lib/R/library'}"
  cat "$SETTINGS_ENV"
} >"${STATE_DIR}/Renviron.site"

apptainer instance start --writable-tmpfs \
  --bind "${STATE_DIR}/data":/data \
  --bind "${STATE_DIR}/qc_shiny_run":/run \
  --bind "${STATE_DIR}/qc_shiny_logs":/var/log/shiny-server \
  --bind "${STATE_DIR}/qc_shiny_lib":/var/lib/shiny-server \
  --bind "${STATE_DIR}/shiny-server.conf":/etc/shiny-server/shiny-server.conf \
  --bind "${STATE_DIR}/Renviron.site":/usr/local/lib/R/etc/Renviron.site \
  sif/qc_shiny.sif qc_shiny

# Create the app's own schema (tables, per enabled Modules/*/init_db_create.sql)
# in this session's fresh database. CREATE DATABASE above only gives us an
# EMPTY database - the project's own setup/init_db.R (which lives inside the
# qc_shiny image, alongside the app itself, and connects using the exact same
# MYSQL_* config) is what actually creates the tables the app expects. Skip
# this and the Shiny app connects fine but immediately errors on every visit
# with "No tables in the DB. Probably not done initializing." - this is NOT
# an --env-file issue (a plain `apptainer exec --env-file` call, unlike
# shiny-server spawning an app session, does see these vars directly).
echo "Initializing QC4Metabolomics database schema..."
apptainer exec --env-file "$SETTINGS_ENV" instance://qc_shiny \
  bash -c 'cd /srv/shiny-server/QC4Metabolomics && Rscript setup/init_db.R' \
  >"${STATE_DIR}/init_db.log" 2>&1

# Foreground shiny-server directly, bypassing the image's own /init (s6-
# overlay) entrypoint entirely: /init hard-requires real root to chown
# things to the 'shiny' user, which we don't have (see above). This is now
# the job's main process, so the session lives exactly as long as this does
# - same as how the RStudio app foregrounds `rserver`. Do NOT `exec` this:
# a plain foreground call lets the `trap cleanup EXIT` above still fire
# (stopping all instances) once shiny-server exits/is killed; `exec` would
# replace this shell - and its traps - entirely.
echo "Starting Shiny Server on port ${port}..."
apptainer exec --env-file "$SETTINGS_ENV" instance://qc_shiny shiny-server
